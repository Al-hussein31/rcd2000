Screen {
    background: #0c0c3a;
    color: #c0c8d0;
    overflow: auto;
}

#header {
    height: 2;
    background: #1a1a5e;
    color: #ffb000;
    content-align: left middle;
    text-style: bold;
    border: solid #4a4a8a;
    padding: 0 1;
}

#tabs {
    height: 2;
    background: #0c0c3a;
    border: solid #4a4a8a;
}

#tabs TabbedContent Tab {
    padding: 0 2;
    color: #8080b0;
}

#tabs TabbedContent Tab.-active {
    color: #ffb000;
    text-style: bold;
}

#footer {
    height: 2;
    background: #1a1a5e;
    color: #ffb000;
    content-align: left middle;
    border: solid #4a4a8a;
    padding: 0 1;
}

#results-panel {
    background: #0a0a2e;
    color: #c0c8d0;
    border: solid #ffb000;
    padding: 1 2;
    min-height: 5;
    margin: 1 0 0 0;
}

#results-panel Static {
    color: #c0c8d0;
}

.static {
    color: #c0c8d0;
    height: 1;
}

Input {
    background: #0a0a2e;
    color: #ffffff;
    border: solid #4a4a8a;
    height: 1;
    padding: 0 1;
}

Input:focus {
    border: solid #ffb000;
    text-style: bold;
}

Select {
    background: #0a0a2e;
    color: #ffffff;
    border: solid #4a4a8a;
    height: 1;
    padding: 0 1;
}

Select:focus {
    border: solid #ffb000;
}

RadioSet {
    background: #0e0e42;
    color: #a0a8d0;
    border: solid #4a4a8a;
    padding: 0 2;
    height: auto;
}

RadioSet > RadioButton {
    padding: 0 1;
    color: #a0a8d0;
    height: 1;
}

RadioSet > RadioButton.-selected {
    color: #ffb000;
    text-style: bold;
}

Button {
    background: #1a1a5e;
    color: #ffb000;
    border: solid #ffb000;
    padding: 0 2;
    height: 1;
    margin: 0 1;
}

Button:hover {
    background: #2a2a7e;
    color: #ffd040;
}

.button-bar {
    height: auto;
    align: left middle;
    margin: 1 0;
}